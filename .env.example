# Copy to .env (local only, never committed) and fill in values.
# GitHub Actions and Streamlit Cloud get these as secrets instead.

# --- Database ---
# sqlite (default, local dev) or turso (production)
DB_BACKEND=sqlite
# Local SQLite file used when DB_BACKEND=sqlite
SQLITE_PATH=radar.db
TURSO_DATABASE_URL=
TURSO_AUTH_TOKEN=

# --- API keys ---
ANTHROPIC_API_KEY=
BRAVE_API_KEY=
YOUTUBE_API_KEY=
SAFE_BROWSING_API_KEY=

# --- Alerts ---
DISCORD_WEBHOOK=

# --- Dashboard ---
APP_PASSWORD=

# --- Control ---
# 1 stops all fetching
PAUSE=0
